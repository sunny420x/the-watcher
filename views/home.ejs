<!doctype html>
<html lang="en">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Watcher / Network Scanner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="intro-splash" aria-hidden="true">
        <div class="intro-splash-copy">
            <p>subnet observatory</p>
            <h1>See what is<br><em>awake.</em></h1>
        </div>
    </div>
    <%-include('components/navigator')%>
    <main class="shell">
        <section aria-label="Scan controls">
            <div class="controls">
                <div class="search-wrap"><span class="search-icon">&gt;_</span><input type="text" id="query"
                        onchange="search(this.value)" placeholder="Enter subnet, e.g. 192.168.1.1"></div>
                <button onclick="back()" class="nav-button" title="Previous subnet"
                    aria-label="Previous subnet">&#8592;</button>
                <button onclick="next()" class="nav-button" title="Next subnet"
                    aria-label="Next subnet">&#8594;</button>
            </div>
            <div style="display: flex; flex-direction: row; gap: 8px;">
                <label class="filter"><input type="checkbox" id="hiddenFilter" onchange="toggleFilter('hidden')">
                    Include hosts with default page.</label>
            </div>
        </section>
        <div class="container">
            <div id="result"></div>
            <div id="network-constellation">
                <div class="graph-heading">
                    <div><h2>Network constellation</h2><span id="constellation-status">Drag to move · scroll to zoom · click a host to preview</span></div>
                    <div class="constellation-tools">
                        <button type="button" onclick="networkConstellation.zoomBy(1.2)" aria-label="Zoom in">+</button>
                        <button type="button" onclick="networkConstellation.zoomBy(1 / 1.2)" aria-label="Zoom out">−</button>
                        <button type="button" onclick="networkConstellation.resetView()">Reset view</button>
                    </div>
                </div>
                <div id="wrapper"><canvas id="myCanvas" aria-label="Interactive network constellation">Your browser does not support the canvas element.</canvas></div>
            </div>
        </div>
        <section aria-label="Must-see hosts">
            <div class="must-see">
                <div class="must-see-heading">
                    <div>
                        <p class="eyebrow">Watchlist</p>
                        <h2>Must-see hosts</h2>
                    </div>
                    <span class="must-see-mark" aria-hidden="true">&#9733;</span>
                </div>
                <p class="must-see-description">Keep important hosts close while you scan the network.</p>
                <div class="must-see-form">
                    <input type="text" id="mustSeeInput" placeholder="IP address or URL" aria-label="Host IP address or URL">
                    <button onclick="addMustSeeHost(document.getElementById('mustSeeInput').value)" class="nav-button">Add host <span aria-hidden="true">+</span></button>
                </div>
                <ul id="mustSeeList" aria-label="Hosts to watch"></ul>
                <script>
                    function getMustSeeHosts() {
                        fetch('/hosts/must-see')
                            .then(response => response.json())
                            .then(data => {
                                const mustSeeList = document.getElementById('mustSeeList');
                                mustSeeList.innerHTML = '';
                                data.mustSee.forEach(host => {
                                    const li = document.createElement('li');
                                    li.textContent = host;
                                    mustSeeList.appendChild(li);
                                });
                            })
                            .catch(err => console.error(err));
                    }
    
                    getMustSeeHosts();
                </script>
                <script>
                    function addMustSeeHost(host) {
                        fetch('/hosts/must-see', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ line: host })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    getMustSeeHosts();
                                }
                            })
                            .catch(err => console.error(err));
                    }
                </script>
            </div>
        </section>
    </main>
    <script>
        let i = 0
        let range = "<%=query%>"
        let current = parseInt(range.split('.')[2])
        range = range.split('.')[0] + '.' + range.split('.')[1] + '.'

        const loadingSkeleton = `<div class="skeleton-results" role="status" aria-label="Scanning network">
            <span class="visually-hidden">Scanning network…</span>
            <section class="skeleton-panel">
                <div class="skeleton-heading"><i class="skeleton-block skeleton-count"></i><i class="skeleton-block skeleton-title"></i></div>
                <i class="skeleton-block skeleton-table-head"></i>
                <i class="skeleton-block skeleton-row"></i>
                <i class="skeleton-block skeleton-row"></i>
                <i class="skeleton-block skeleton-row"></i>
            </section>
            <section class="skeleton-panel skeleton-panel-small">
                <div class="skeleton-heading"><i class="skeleton-block skeleton-count"></i><i class="skeleton-block skeleton-title"></i></div>
                <i class="skeleton-block skeleton-row"></i>
                <i class="skeleton-block skeleton-row"></i>
            </section>
        </div>`

        function run(range) {
            fetch(`/run/${range}`).then(res => {
                if (res.ok) {
                    return res.json()
                } else {
                    return "Error"
                }
            }).then(data => {
                document.getElementById('result').innerHTML = data.html
                networkConstellation.render(data.data.open_ip || [], range);
            });

        }

        function next() {
            if (parseInt(range.split('.')[1]) + 1 == 256 && current + 1 == 256) {
                current = 0
                range = parseInt(range.split('.')[0]) + 1 + '.' + '0.';
            } else {
                if (current + 1 == 256) {
                    current = -1;
                    range = range.split('.')[0] + '.' + (parseInt(range.split('.')[1]) + 1) + '.';
                }
            }
            document.getElementById('result').innerHTML = loadingSkeleton
            run(range + (current += 1)); document.getElementById('query').value = range + current
            history.pushState(null, null, '/' + range + current);

            networkConstellation.clear();
            document.getElementsByName('currentTarget').forEach(el => el.textContent = range + current);
        }

        function back() {
            if (parseInt(range.split('.')[1]) - 1 == -1) {
                current = 256
                range = parseInt(range.split('.')[0]) - 1 + '.' + '255.';
            } else {
                if (current - 1 == -1) {
                    current = 256;
                    range = range.split('.')[0] + '.' + (parseInt(range.split('.')[1]) - 1) + '.';
                }
            }
            document.getElementById('result').innerHTML = loadingSkeleton
            run(range + (current -= 1)); document.getElementById('query').value = range + current
            history.pushState(null, null, '/' + range + current);

            networkConstellation.clear();
            document.getElementsByName('currentTarget').forEach(el => el.textContent = range + current);
        }

        function initField() {
            document.getElementById('result').innerHTML = loadingSkeleton

            document.getElementById('query').value = range + current
            document.getElementsByName('currentTarget').forEach(el => el.textContent = range + current);
            run(range + current)
        }

        function search(value) {
            document.getElementById('result').innerHTML = loadingSkeleton
            run(value);
            range = value.split('.')[0] + '.' + value.split('.')[1] + '.';
            current = parseInt(value.split('.')[2])
            history.pushState(null, null, '/' + value);
            document.getElementsByName('currentTarget').forEach(el => el.textContent = value);
        }

        function toggleFilter(option) {
            if (option == "hidden") {
                document.querySelectorAll('.hidden, .unhidden').forEach(row => {
                    row.classList.toggle('hidden');
                    row.classList.toggle('unhidden');
                });
            }
        }

        document.addEventListener("keydown", (event) => {
            if (event.defaultPrevented) {
                return;
            }

            switch (event.key) {
                case "ArrowLeft":
                    back()
                    break;
                case "ArrowRight":
                    next()
                    break;
                default:
                    return;
            }

            event.preventDefault();
        }, true);

        initField()

        function previewHost(host) {
            let previewUrl;
            try {
                previewUrl = new URL(host, window.location.origin);
                if (!['http:', 'https:'].includes(previewUrl.protocol)) {
                    throw new Error('Unsupported protocol');
                }
            } catch (error) {
                Swal.fire({
                    title: 'Invalid host',
                    text: 'This host cannot be previewed.',
                    icon: 'error'
                });
                return;
            }

            Swal.fire({
                title: `Preview · ${previewUrl.host}`,
                html: '<div class="host-preview-frame"></div>',
                width: 'min(1100px, 94vw)',
                padding: '18px',
                showCloseButton: true,
                showConfirmButton: false,
                customClass: { popup: 'host-preview-popup' },
                didOpen: () => {
                    const frame = document.createElement('iframe');
                    frame.src = previewUrl.protocol === 'http:'
                        ? `/preview?url=${encodeURIComponent(previewUrl.href)}`
                        : previewUrl.href;
                    frame.title = `Preview of ${previewUrl.host}`;
                    frame.loading = 'lazy';
                    frame.referrerPolicy = 'no-referrer';
                    frame.setAttribute('sandbox', 'allow-scripts allow-forms allow-popups');
                    frame.className = 'host-preview-iframe';
                    document.querySelector('.host-preview-frame').appendChild(frame);
                }
            });
        }

        function nmap(ip) {
            Swal.fire({
                title: 'Running Nmap...',
                didOpen: () => {
                    Swal.showLoading()
                },
                allowOutsideClick: false
            });
            fetch('/nmap/' + ip)
                .then(response => response.json())
                .then(data => {
                    Swal.close();
                    Swal.fire({
                        title: 'Nmap Result',
                        html: `<textarea readonly style="width:100%;height:400px;">${data.stdout}</textarea>`,
                        width: 800,
                        confirmButtonText: 'Close'
                    });
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }

        function whois(ip) {
            Swal.fire({
                title: 'Looking up WHOIS...',
                didOpen: () => Swal.showLoading(),
                allowOutsideClick: false
            });

            fetch('/whois/' + encodeURIComponent(ip))
                .then(async response => {
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'WHOIS lookup failed.');
                    return data;
                })
                .then(data => {
                    Swal.fire({
                        title: `WHOIS · ${ip}`,
                        html: `<textarea readonly style="width:100%;height:400px;">${data.stdout || 'No WHOIS data returned.'}</textarea>`,
                        width: 800,
                        confirmButtonText: 'Close'
                    });
                })
                .catch(error => {
                    Swal.fire({ title: 'WHOIS lookup failed', text: error.message, icon: 'error' });
                });
        }

        function rtsp(ip) {
            Swal.fire({
                title: 'Running Nmap...',
                didOpen: () => {
                    Swal.showLoading()
                },
                allowOutsideClick: false
            });
            fetch('/rtsp/' + ip)
                .then(response => response.json())
                .then(data => {
                    Swal.close();
                    Swal.fire({
                        title: 'RTSP Result',
                        html: `<textarea readonly style="width:100%;height:400px;">${data.stdout}</textarea>`,
                        width: 800,
                        confirmButtonText: 'Close'
                    });
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/network-constellation.js"></script>
</body>

</html>
