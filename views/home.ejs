<!doctype html>
<html lang="en">

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Watcher / Network Scanner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <%-include('components/navigator')%>
    <main class="shell">
        <section class="intro">
            <div class="intro-copy">
                <p class="eyebrow">subnet observatory</p>
                <h1>See what is<br><em>awake.</em></h1>
                <!-- <p>Map every visible service in a local subnet. Follow the signal, then inspect the hosts that matter.</p> -->
            </div>
            <div class="scan-meta">CURRENT TARGET<strong id="targetLabel"><%=query%>.0/24</strong></div>
        </section>
        <section aria-label="Scan controls">
            <div class="controls">
                <div class="search-wrap"><span class="search-icon">&gt;_</span><input type="text" id="query"
                        onchange="search(this.value)" placeholder="Enter subnet, e.g. 192.168.1.1"></div>
                <button onclick="back()" class="nav-button" title="Previous subnet"
                    aria-label="Previous subnet">&#8592;</button>
                <button onclick="next()" class="nav-button" title="Next subnet"
                    aria-label="Next subnet">&#8594;</button>
            </div>
            <div style="display: flex; flex-direction: row; gap: 8px;">
                <label class="filter"><input type="checkbox" id="hiddenFilter" onchange="toggleFilter('hidden')">
                    Include hosts with default page.</label>
                <label class="filter"><input type="checkbox" id="networkConstellationFilter"
                        onchange="toggleNetworkConstellation()"> Show network constellation.</label>
            </div>
            <script>
                function toggleNetworkConstellation() {
                    const networkConstellation = document.getElementById('network-constellation');
                    networkConstellation.style.display = document.getElementById('networkConstellationFilter').checked ? 'block' : 'none';
                }

            </script>
        </section>
        <div id="result">
        </div>
        <div id="network-constellation" style="display: none;">
            <div class="graph-heading">
                <h2>Network constellation</h2><span>live topology / port 80</span>
            </div>
            <div id="wrapper"><canvas id="myCanvas">Your browser does not support the canvas element.</canvas></div>
        </div>
        <section aria-label="Must-see hosts">
            <div class="must-see">
                <h2>Must-see hosts</h2>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <input type="text" id="mustSeeInput" placeholder="Add a must-see host" class="controls"
                        style="color: white; outline: none;">
                    <button onclick="addMustSeeHost(document.getElementById('mustSeeInput').value)"
                        class="nav-button">Add</button>
                </div>
                <ul id="mustSeeList"></ul>
                <script>
                    function getMustSeeHosts() {
                        fetch('/hosts/must-see')
                            .then(response => response.json())
                            .then(data => {
                                const mustSeeList = document.getElementById('mustSeeList');
                                mustSeeList.innerHTML = '';
                                data.mustSee.forEach(host => {
                                    const li = document.createElement('li');
                                    li.textContent = host;
                                    mustSeeList.appendChild(li);
                                });
                            })
                            .catch(err => console.error(err));
                    }
    
                    getMustSeeHosts();
                </script>
                <script>
                    function addMustSeeHost(host) {
                        fetch('/hosts/must-see', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ line: host })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    getMustSeeHosts();
                                }
                            })
                            .catch(err => console.error(err));
                    }
                </script>
                <ul id="mustSeeList"></ul>
            </div>
        </section>
    </main>
    <script>
        const canvas = document.getElementById("myCanvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth + canvas.parentElement.clientWidth / 2;
            canvas.height = canvas.parentElement.clientHeight * 2;


            wrapper.scrollLeft = (wrapper.scrollWidth - wrapper.clientWidth) / 2;
            wrapper.scrollTop = (wrapper.scrollHeight - wrapper.clientHeight) / 2;
        }

        resizeCanvas();
        window.addEventListener("resize", resizeCanvas);

        // Function to draw a node (circle)
        function drawNode(x, y, radius, color, address) {
            ctx.beginPath(); // Start a new path
            ctx.arc(x, y, radius, 0, Math.PI * 2, true); // Draw a full circle
            ctx.fillStyle = color;
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = "black";
            ctx.fillText(address, x - radius + 8, y);
        }

        // Function to draw a line between two points (x1, y1) and (x2, y2)
        function drawLine(x1, y1, x2, y2, color, width) {
            ctx.beginPath();
            ctx.moveTo(x1, y1); // Move the "pen" to the start point
            ctx.lineTo(x2, y2); // Draw a line to the end point
            ctx.strokeStyle = color;
            ctx.lineWidth = width;
            ctx.stroke(); // Render the line
        }

        function clearCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        let i = 0
        let range = "<%=query%>"
        let current = parseInt(range.split('.')[2])
        range = range.split('.')[0] + '.' + range.split('.')[1] + '.'

        const loadingSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid" width="50" height="50" style="shape-rendering: auto; display: block; background: rgba(255, 255, 255, 0); margin: auto; margin-top: 100px;" xmlns:xlink="http://www.w3.org/1999/xlink"><g><circle stroke-dasharray="164.93361431346415 56.97787143782138" r="35" stroke-width="10" stroke="#222222" fill="none" cy="50" cx="50">
            <animateTransform keyTimes="0;1" values="0 50 50;360 50 50" dur="1s" repeatCount="indefinite" type="rotate" attributeName="transform"></animateTransform>
            </circle><g></g></g><!-- [ldio] generated by https://loading.io --></svg>`

        function run(range) {
            fetch(`/run/${range}`).then(res => {
                if (res.ok) {
                    return res.json()
                } else {
                    return "Error"
                }
            }).then(data => {
                document.getElementById('result').innerHTML = data.html
                wrapper = document.getElementById('wrapper')

                nodes = []

                sx = canvas.width / 2;
                sy = canvas.height / 2;

                let centerX = sx;
                let centerY = sy;

                let baseRadius = 150;     // first ring distance
                let ringGap = 120;        // space between rings
                let nodeRadius = 40;

                let nodesPerRing = 12;    // first ring capacity
                let ring = 0;
                let indexInRing = 0;

                data.data.open_ip.forEach((node, index) => {

                    if (indexInRing >= nodesPerRing) {
                        ring++;
                        indexInRing = 0;

                        // increase capacity as ring grows
                        nodesPerRing = Math.floor((2 * Math.PI * (baseRadius + ring * ringGap)) / (nodeRadius * 2.5));
                    }

                    let radius = baseRadius + ring * ringGap;
                    let angle = (2 * Math.PI / nodesPerRing) * indexInRing;

                    let x = centerX + radius * Math.cos(angle);
                    let y = centerY + radius * Math.sin(angle);

                    drawLine(centerX, centerY, x, y, "#bbb", 1);

                    drawNode(
                        x,
                        y,
                        nodeRadius,
                        "#2ecc71",
                        node.host.replace('http://', '')
                    );


                    indexInRing++;
                });

                drawNode(centerX, centerY, 50, "#444", range + ".0/24")
            });
        }

        function next() {
            if (parseInt(range.split('.')[1]) + 1 == 256 && current + 1 == 256) {
                current = 0
                range = parseInt(range.split('.')[0]) + 1 + '.' + '0.';
            } else {
                if (current + 1 == 256) {
                    current = -1;
                    range = range.split('.')[0] + '.' + (parseInt(range.split('.')[1]) + 1) + '.';
                }
            }
            document.getElementById('result').innerHTML = loadingSvg
            run(range + (current += 1)); document.getElementById('query').value = range + current
            history.pushState(null, null, '/' + range + current);

            clearCanvas();

        }

        function back() {
            if (parseInt(range.split('.')[1]) - 1 == -1) {
                current = 256
                range = parseInt(range.split('.')[0]) - 1 + '.' + '255.';
            } else {
                if (current - 1 == -1) {
                    current = 256;
                    range = range.split('.')[0] + '.' + (parseInt(range.split('.')[1]) - 1) + '.';
                }
            }
            document.getElementById('result').innerHTML = loadingSvg
            run(range + (current -= 1)); document.getElementById('query').value = range + current
            history.pushState(null, null, '/' + range + current);

            clearCanvas();
        }

        function initField() {
            document.getElementById('result').innerHTML = loadingSvg

            document.getElementById('query').value = range + current
            run(range + current)
        }

        function search(value) {
            document.getElementById('result').innerHTML = loadingSvg
            run(value);
            range = value.split('.')[0] + '.' + value.split('.')[1] + '.';
            current = parseInt(value.split('.')[2])
            history.pushState(null, null, '/' + value);
        }

        function toggleFilter(option) {
            if (option == "hidden") {
                document.querySelectorAll('.hidden, .unhidden').forEach(row => {
                    row.classList.toggle('hidden');
                    row.classList.toggle('unhidden');
                });
            }
        }

        document.addEventListener("keydown", (event) => {
            if (event.defaultPrevented) {
                return;
            }

            switch (event.key) {
                case "ArrowLeft":
                    back()
                    break;
                case "ArrowRight":
                    next()
                    break;
                default:
                    return;
            }

            event.preventDefault();
        }, true);

        initField()
        
        function nmap(ip) {
            fetch('/nmap/' + ip)
                .then(response => response.json())
                .then(data => {
                    Swal.fire({
                        title: 'Nmap Result',
                        html: `<pre>${data.stdout}</pre>`,
                        width: 800,
                        confirmButtonText: 'Close'
                    });
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }
        function rtsp(ip) {
            fetch('/rtsp/' + ip)
                .then(response => response.json())
                .then(data => {
                    Swal.fire({
                        title: 'RTSP Result',
                        html: `<pre>${data.stdout}</pre>`,
                        width: 800,
                        confirmButtonText: 'Close'
                    });
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>

</html>