<div id="page-loading-splash" class="intro-splash" aria-hidden="true">
    <div class="intro-splash-copy">
        <p data-en-text="subnet observatory" data-th-text="หอสังเกตการณ์เครือข่าย">subnet observatory</p>
        <h1><span data-en-text="See what is" data-th-text="มาดูกันว่าอะไร">See what is</span><br><em data-en-text="awake." data-th-text="กำลังออนไลน์">awake.</em></h1>
    </div>
</div>
<script>
    (() => {
        const splash = document.getElementById('page-loading-splash');
        let showTimer;
        const hideSplash = () => {
            clearTimeout(showTimer);
            splash.classList.remove('is-visible');
            splash.setAttribute('aria-hidden', 'true');
        };

        if (document.readyState === 'complete') return;
        showTimer = setTimeout(() => {
            if (document.readyState === 'complete') return;
            splash.classList.add('is-visible');
            splash.setAttribute('aria-hidden', 'false');
        }, 140);
        window.addEventListener('load', hideSplash, { once: true });
    })();
</script>
