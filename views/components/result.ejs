<div class="d-flex flex-wrap mt-4">
    <% open_ip = open_ip || []; %>
    <% open_ftp = open_ftp || []; %>
    <% open_ssh = open_ssh || []; %>
    <% open_rtsp = open_rtsp || []; %>
    <% if(open_ip.length > 0) { %>
    <div>
        <h2><span class="badge bg-primary"><%=open_ip.length%></span> <span data-en-text="Web servers" data-th-text="เว็บเซิร์ฟเวอร์">Web servers</span></h2>
        <div class="overflow-auto" style="max-height: 500px;">
        <table class="table mt-4">
            <tr>
                <th data-en-text="Type" data-th-text="ประเภท">Type</th>
                <th data-en-text="IP Address" data-th-text="IP แอดเดรส">IP Address</th>
                <th colspan="2" data-en-text="Action" data-th-text="การทำงาน">Action</th>
            </tr>
            <% if(open_ip.length != 0) { %>
                <% 
                let hiddenTypes = ['DEFAULT', 'CCTV', 'ROUTER', 'ERROR']
                const classify = (title = '') => {
                    if (filter.error_page.some(p => title.includes(p))) return 'ERROR';
                    if (filter.cctv_page.some(p => title.includes(p))) return 'CCTV';
                    if (filter.router_page.some(p => title.includes(p))) return 'ROUTER';
                    if (filter.default_webserver_page.some(p => title.includes(p))) return 'DEFAULT';
                    if (filter.directory_listing.some(p => title.includes(p))) return 'DIRECTORY';
                    if (filter.nsfw.some(p => title.includes(p))) return 'NSFW';
                    return 'OPEN PORT';
                };
                
                open_ip = open_ip.map(ip => ({
                    ...ip,
                    type: classify(ip.title || '')
                }));
                open_ip.forEach(ip => { 
                    %>
                    <tr <% if(hiddenTypes.includes(ip.type)) {%>class="hidden"<%}%> >
                        <td data-category-label="<%= ip.type %>"><%=ip.type%></td>
                        <td><a href="<%= ip.host %>" target="_blank" rel="noopener noreferrer"><% if(ip.title) { %>[<%=ip.title%>]<% } %> <%= ip.host.slice(7) %></a></td>
                        <td><button onclick="nmap('<%=ip.host.slice(7)%>')">Nmap</button> <button onclick="whois('<%=ip.host.slice(7)%>')">WHOIS</button></td>
                    </tr>
                <% }) %>
            <%}%>
        </table>
        </div>
    </div>
    <%}%>
    <% if(open_ssh) { %> 
    <div>
        <h2><span class="badge bg-primary"><%=open_ssh.length%></span> <span data-en-text="SSH Servers" data-th-text="เซิร์ฟเวอร์ SSH">SSH Servers</span></h2>
        <div class="overflow-auto" style="max-height: 500px;">
        <table class="table mt-4">
            <tr>
                <th data-en-text="IP Address" data-th-text="IP แอดเดรส">IP Address</th>
            </tr>
            <% if(open_ssh.length != 0) { %>
            <% open_ssh.forEach(ip => { 
            %>
            <tr>
                <td><%= ip %></td>
            </tr>
            <% }) %>
            <%}%>
        </table>
        </div>
    </div>
    <%}%>
    <% if(open_ftp) { %>
    <div>
        <h2><span class="badge bg-primary"><%=open_ftp.length%></span> <span data-en-text="FTP Servers" data-th-text="เซิร์ฟเวอร์ FTP">FTP Servers</span></h2>
        <div class="overflow-auto" style="max-height: 500px;">
        <table class="table mt-4">
            <tr>
                <th data-en-text="IP Address" data-th-text="IP แอดเดรส">IP Address</th>
            </tr>
            <% if(open_ftp.length != 0) { %>
            <% open_ftp.forEach(ip => { 
            %>
            <tr>
                <td><%= ip %></td>
            </tr>
            <% }) %>
            <%}%>
        </table>
        </div>
    </div>
    <%}%>
    <% if(open_rtsp) { %>
    <div>
        <h2><span class="badge bg-primary"><%=open_rtsp.length%></span> <span data-en-text="RTSP Servers" data-th-text="เซิร์ฟเวอร์ RTSP">RTSP Servers</span></h2>
        <div class="overflow-auto" style="max-height: 500px;">
        <table class="table mt-4">
            <tr>
                <th data-en-text="IP Address" data-th-text="IP แอดเดรส">IP Address</th>
            </tr>
            <% if(open_rtsp.length != 0) { %>
            <% open_rtsp.forEach(ip => { 
            %>
            <tr>
                <td><button onclick="rtsp('<%= ip %>')"><%= ip %></button></td>
            </tr>
            <% }) %>
            <%}%>
        </table>
        </div>
    </div>
    <%}%>
</div>
