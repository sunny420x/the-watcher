<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title data-en-text="What we found ? | The Watcher" data-th-text="เราเจออะไรบ้าง ? | The Watcher">What we found ? | The Watcher</title>
    <meta name="description" content="Summarize discovered IPs and web page titles across recorded network scans." data-en-content="Summarize discovered IPs and web page titles across recorded network scans." data-th-content="สรุป IP และ หัวข้อของเว็บไซต์ที่พบจากการสแกนเครือข่าย">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Prompt:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/js/theme.js"></script>
    <script src="/js/language.js"></script>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="summary-page">
    <%- include('components/navigator') %>
    <main class="shell summary-shell">
        <header class="search-heading">
            <p class="eyebrow" data-en-text="Cyberspace search engine" data-th-text="สำรวจเครือข่ายอินเทอร์เน็ต">Cyberspace search engine</p>
            <h1 data-en-text="What we found ?" data-th-text="เราเจออะไรบ้าง ?">What we found ?</h1>
            <p data-en-text="Overview of the hosts and services currently recorded in the scan index." data-th-text="ภาพรวมโฮสต์และบริการที่บันทึกไว้ในดัชนีการสแกน">Overview of the hosts and services currently recorded in the scan index.</p>
            <div class="summary-heading-actions">
                <span class="summary-cache-status"><span data-en-text="Cached at" data-th-text="แคชเมื่อ">Cached at</span> <time data-localized-date="<%= summarizedAt.toISOString() %>"><%= summarizedAt.toLocaleString() %></time></span>
                <div class="summary-refresh-controls">
                    <form class="summary-refresh-form" method="post" action="/summary/refresh">
                        <button class="summary-refresh-button" type="submit" <%= refreshAvailableAt ? 'disabled' : '' %> data-en-text="Re-summarize" data-th-text="สรุปใหม่">Re-summarize</button>
                    </form>
                    <% if (refreshAvailableAt) { %>
                        <span id="summary-refresh-countdown" class="summary-refresh-countdown" data-unlock-at="<%= refreshAvailableAt.getTime() %>" data-en-template="Available again in {time}" data-th-template="กดได้อีกครั้งใน {time}"></span>
                    <% } %>
                </div>
            </div>
        </header>

        <section class="summary-metrics" aria-label="Scan totals" data-en-aria-label="Scan totals" data-th-aria-label="ยอดรวมการสแกน">
            <article class="summary-metric">
                <span data-en-text="Unique IPs" data-th-text="จำนวน IP ที่สแกน">Unique IPs</span>
                <strong><%= stats.total_ips.toLocaleString('en-US') %></strong>
            </article>
            <article class="summary-metric">
                <span data-en-text="Subnet ranges with findings" data-th-text="ช่วง Subnet ที่พบโฮสต์">Subnet ranges with findings</span>
                <strong><%= stats.ranges_with_findings.toLocaleString('en-US') %></strong>
            </article>
            <article class="summary-metric">
                <span data-en-text="Websites" data-th-text="เว็บไซต์">Web IPs</span>
                <strong><%= stats.web_ips.toLocaleString('en-US') %></strong>
            </article>
            <article class="summary-metric">
                <span data-en-text="SSH" data-th-text="SSH">SSH IPs</span>
                <strong><%= stats.ssh_ips.toLocaleString('en-US') %></strong>
            </article>
            <article class="summary-metric">
                <span data-en-text="FTP" data-th-text="FTP">FTP IPs</span>
                <strong><%= stats.ftp_ips.toLocaleString('en-US') %></strong>
            </article>
            <article class="summary-metric">
                <span data-en-text="RTSP" data-th-text="RTSP">RTSP IPs</span>
                <strong><%= stats.rtsp_ips.toLocaleString('en-US') %></strong>
            </article>
        </section>

        <section class="queue-panel summary-panel" aria-labelledby="summary-web-title">
            <div class="queue-panel-heading">
                <div>
                    <p class="eyebrow" data-en-text="Website titles" data-th-text="หัวข้อของเว็บไซต์">Website titles</p>
                    <h2 id="summary-web-title" data-en-text="Website Category" data-th-text="ประเภทเว็บไซต์">Web IPs by page type</h2>
                </div>
            </div>
            <% if (stats.web_ips === 0) { %>
                <div class="index-empty-state" data-en-text="No web hosts have been recorded yet." data-th-text="ยังไม่มีโฮสต์เว็บที่บันทึกไว้">No web hosts have been recorded yet.</div>
            <% } else { %>
                <div class="summary-category-grid">
                    <% categoryRows.filter(row => row.ipCount > 0).forEach(row => { %>
                        <article class="summary-category-card">
                            <div class="summary-category-card-heading">
                                <h3 data-category-label="<%= row.category %>"><%= row.category %></h3>
                                <strong><%= row.ipCount.toLocaleString('en-US') %></strong>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
            <p class="summary-note" data-en-text="Each IP is counted once. When a title matches more than one keyword, the category with the highest match priority is used." data-th-text="นับแต่ละ IP เพียงครั้งเดียว หาก Title ตรงกับหลายคีย์เวิร์ด จะใช้หมวดที่มีลำดับความสำคัญสูงสุด">Each IP is counted once. When a title matches more than one keyword, the category with the highest match priority is used.</p>
        </section>
    </main>
    <script src="/js/summary.js"></script>
</body>

</html>
